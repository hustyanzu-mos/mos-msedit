#!/bin/sh
# MSEdit wrapper for MOS.
# The real binary is installed by the plugin .deb at /usr/lib/msedit/msedit.

PLG_DIR="${MSEDIT_PLUGIN_DIR:-/boot/optional/plugins/msedit}"
BIN="${MSEDIT_BIN:-/usr/lib/msedit/msedit}"
LIB_DIR="$PLG_DIR/lib"

if [ ! -x "$BIN" ]; then
  echo "MSEdit is not installed. Reinstall the MSEdit plugin from MOS Hub." >&2
  exit 127
fi

export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$BIN" "$@"
#!/bin/bash
# MSEdit backend for MOS.
# The msedit binary is installed by the plugin .deb under /usr/lib/msedit.
# This backend reports status and can install the optional ICU package.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

PLG_DIR="${MSEDIT_PLUGIN_DIR:-/boot/optional/plugins/msedit}"
BIN="${MSEDIT_BIN:-/usr/lib/msedit/msedit}"
SETTINGS="$PLG_DIR/settings.json"
SHARE_DIR="${MSEDIT_SHARE_DIR:-/usr/share/msedit-plugin}"

say() { echo "$*"; }

ensure_settings() {
  mkdir -p "$PLG_DIR"
  if [ ! -f "$SETTINGS" ]; then
    if [ -f "$SHARE_DIR/settings.json" ]; then
      cp -f "$SHARE_DIR/settings.json" "$SETTINGS"
    else
      printf '{}\n' > "$SETTINGS"
    fi
  fi
}

current_version() {
  if [ -x "$BIN" ]; then
    "$BIN" --version 2>/dev/null | awk '{print $3}'
  fi
}

cmd_status() {
  local installed=false version
  if [ -x "$BIN" ]; then
    installed=true
  fi
  version="$(current_version)"
  [ -n "$version" ] || version="not installed"
  printf '{"installed":%s,"version":"%s","command":"msedit"}\n' "$installed" "$version"
}

cmd_install_icu() {
  local pkg tmp deb
  pkg="$(apt-cache search '^libicu[0-9]+$' 2>/dev/null | awk '{print $1}' | sort -V | tail -n1)"
  [ -n "$pkg" ] || pkg="libicu76"

  mkdir -p "$PLG_DIR/packages"
  printf '%s\n' "$pkg" > "$PLG_DIR/packages/packages"

  if command -v dpkg >/dev/null 2>&1; then
    ( cd "$PLG_DIR/packages" && apt-get download "$pkg" >/dev/null 2>&1 ) || true
    if ls "$PLG_DIR"/packages/*.deb >/dev/null 2>&1; then
      dpkg -i "$PLG_DIR"/packages/*.deb >/dev/null 2>&1 || true
      ldconfig 2>/dev/null || true
    fi
  fi
  say "ICU package: $pkg"
}

cmd_uninstall() {
  rm -f /usr/bin/plugins/msedit 2>/dev/null || true
  if [ -L /usr/bin/edit ] && [ "$(readlink /usr/bin/edit)" = "msedit" ]; then
    rm -f /usr/bin/edit 2>/dev/null || true
  fi
  say "Removed msedit plugin entry. Persistent data kept in $PLG_DIR"
}

ensure_settings

case "${1:-}" in
  status) cmd_status ;;
  install_icu) cmd_install_icu ;;
  version) current_version ;;
  uninstall) cmd_uninstall ;;
  *)
    echo "Usage: $0 {status|install_icu|version|uninstall}" >&2
    exit 2
    ;;
esac
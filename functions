#!/bin/bash
# MOS lifecycle hooks for the msedit plugin.

PLG_DIR="/boot/optional/plugins/msedit"
HB="/usr/bin/plugins/msedit"
SHARE_DIR="/usr/share/msedit-plugin"

_setting() {
  jq -r --arg k "$1" '.[$k] // empty' "$PLG_DIR/settings.json" 2>/dev/null
}

_restore() {
  mkdir -p "$PLG_DIR/bin" "$PLG_DIR/lib"

  for f in msedit-backend msedit-wrapper functions; do
    if [ ! -f "$PLG_DIR/$f" ] && [ -f "$SHARE_DIR/$f" ]; then
      cp -f "$SHARE_DIR/$f" "$PLG_DIR/$f"
    fi
  done

  if [ ! -f "$PLG_DIR/settings.json" ] && [ -f "$SHARE_DIR/settings.json" ]; then
    cp -f "$SHARE_DIR/settings.json" "$PLG_DIR/settings.json"
  fi

  if [ ! -x /usr/bin/plugins/msedit ]; then
    mkdir -p /usr/bin/plugins
    if [ -f "$PLG_DIR/msedit-backend" ]; then
      cp -f "$PLG_DIR/msedit-backend" /usr/bin/plugins/msedit
    elif [ -f "$SHARE_DIR/msedit-backend" ]; then
      cp -f "$SHARE_DIR/msedit-backend" /usr/bin/plugins/msedit
    fi
    chmod 0755 /usr/bin/plugins/msedit 2>/dev/null || true
  fi

  if [ ! -x /usr/bin/msedit ]; then
    if [ -f "$PLG_DIR/msedit-wrapper" ]; then
      cp -f "$PLG_DIR/msedit-wrapper" /usr/bin/msedit
    elif [ -f "$SHARE_DIR/msedit-wrapper" ]; then
      cp -f "$SHARE_DIR/msedit-wrapper" /usr/bin/msedit
    fi
    chmod 0755 /usr/bin/msedit 2>/dev/null || true
  fi

  if [ -x "$HB" ]; then
    "$HB" ensure_runtime >/dev/null 2>&1 || true
  fi
}

install() {
  _restore

  local auto
  auto="$(_setting auto_install)"
  [ -z "$auto" ] && auto=true

  if [ ! -x "$PLG_DIR/bin/msedit" ] && [ "$auto" = "true" ] && [ -x "$HB" ]; then
    "$HB" install_binary >/dev/null 2>&1 || true
  fi

  if [ -x "$HB" ]; then
    "$HB" install_icu >/dev/null 2>&1 || true
  fi

  return 0
}

uninstall() {
  if [ -x "$HB" ]; then
    "$HB" uninstall >/dev/null 2>&1 || true
  else
    rm -f /usr/bin/plugins/msedit /usr/bin/msedit /usr/bin/msedit.real 2>/dev/null || true
    if [ -L /usr/bin/edit ] && [ "$(readlink /usr/bin/edit)" = "msedit" ]; then
      rm -f /usr/bin/edit 2>/dev/null || true
    fi
  fi
}

plugin_update() {
  _restore
}

mos_start() {
  _restore
}

mos_osupdate() {
  _restore
}